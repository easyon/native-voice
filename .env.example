# Service
NV_CONFIG=configs/service.yaml
NV_HOST=127.0.0.1
NV_PORT=8090
NV_LOG_LEVEL=INFO

# API key database (SQLite for single-node dev)
NV_DB_PATH=.data/native_voice.db

# Set to 1 in dev to create a printable dev key when the DB has none.
NV_DEV_KEY=0

# HMAC secret for 60-second conversation tickets. Required when running more
# than one gateway replica; leave empty for single-process dev.
NV_TICKET_SECRET=

# Model paths (relative to the repo root unless absolute)
NV_TTS_MODEL=models/Fun-CosyVoice3-0.5B
NV_TTS_PROMPT_WAV=third_party/CosyVoice-main/asset/zero_shot_prompt.wav
NV_ASR_DEVICE=cuda:0

# Provider selection (overrides configs/service.yaml)
# ASR: paraformer | qwen3asr
# TTS: cosyvoice3 | qwen3tts | qwen3tts_vllm | cosyvoice3_vllm
NV_ASR_PROVIDER=paraformer
NV_TTS_PROVIDER=cosyvoice3

# Optional llama.cpp server for the conversation API
NV_LLM_SERVER=bin/llama/llama-server.exe
NV_LLM_GPU_LAYERS=0

# Used by scripts/serve_dev.*: cpu = -ngl 0 + CPU binary, gpu = -ngl 99 + CUDA binary
LLM_DEVICE=cpu
